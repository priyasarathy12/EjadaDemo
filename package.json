{
  "name": "saucedemo-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-browser UI automation for SauceDemo using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.2",
    "dotenv": "^16.6.1",
    "typescript": "^5.9.3"
  }
}